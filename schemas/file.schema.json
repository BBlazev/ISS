{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "filesize", "uploaded_on"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "filename_download": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "type": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$"
    },
    "filesize": {
      "type": "integer",
      "minimum": 0
    },
    "width": { "type": "integer", "minimum": 0 },
    "height": { "type": "integer", "minimum": 0 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "uploaded_on": {
      "type": "string",
      "format": "date-time"
    }
  }
}
